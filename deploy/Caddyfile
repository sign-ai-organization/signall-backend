# Reverse proxy in front of the backend. Design: docs/plan-proxy-tls.md.
#
# Caddy does one thing here: it terminates TLS on 443 and hands the decrypted
# connection to the backend on loopback. The backend keeps listening on
# 0.0.0.0:8080 without knowing that this file exists, and the WebSocket path
# (`/ws/translate`) is not special-cased: `reverse_proxy` forwards the
# `Upgrade` headers on its own.
#
# It must run on the host network (`docker-compose.host.yml`), because on the
# compose network `127.0.0.1` is the container itself and the backend would be
# unreachable without going through `host.docker.internal`, which the host
# firewall filters.
{
	# The admin API is only useful for live reconfiguration. On the host network
	# it would listen on every interface, which is unwanted for a demo.
	admin off

	# The certificate was issued by mkcert (deploy/certs/, phase 1 of the plan).
	# Automatic HTTPS would try to obtain and manage its own, so it is disabled:
	# this site declares its certificate explicitly below.
	auto_https off
}

:443 {
	tls /etc/caddy/certs/lab.pem /etc/caddy/certs/lab-key.pem

	# Static download of the Android APK (`docs/plan-wifi.md`, phase 2). It has to
	# be a `handle` block and not a bare directive: Caddy orders `handle` blocks by
	# path specificity, so `/apk/*` wins over the catch-all. A top-level
	# `reverse_proxy` would match everything first and the 404 would be hard to
	# read.
	#
	# The directory is a bind mount (`docker-compose.host.yml`) filled by
	# `../signall-android/tools/wifi/publicar-apk.sh`. `handle_path` strips the
	# `/apk` prefix, so `/apk/` serves `index.html` from the root below.
	handle_path /apk/* {
		root * /srv/apk
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
