# Template of the development-only overrides.
#
# Copy it to `.env.local` (not versioned) when the local run should use a
# provider other than the official one. `.env.local` wins over `.env`, so the
# official values there stay untouched.
#
# The example is a local Ollama. A cold model needs about 7 s to load, so the
# official 5 s plus one retry fails the first phrase after an idle; ten seconds
# and zero retries fit that load and stay under the 15 s the client waits.
#
# With `docker compose`, `docker-compose.yml` passes `.env.local` to the
# container when the file exists.
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=0
