.venv/
__pycache__/
*.pyc
.env
# Development-only overrides: they win over `.env` and are not versioned.
# The template is `.env.local.example`.
.env.local
# Caches of the static analyzers (ruff, mypy).
.ruff_cache/
.mypy_cache/

# Coverage artifacts of `scripts/cobertura.sh`. They are regenerated on every
# run and `coverage.xml` is read by the Sonar scanner from the working tree:
# it does not need to be committed.
.coverage
.coverage.*
coverage.xml

# Local TLS material of the `caddy` service in `docker-compose.host.yml`:
# the private key and the lab CA must never enter the repository. The
# directory itself stays tracked so the bind mount has a source on a fresh
# clone; the files are reissued with mkcert (docs/plan-proxy-tls.md, phase 1).
deploy/certs/*
!deploy/certs/.gitkeep

# APKs and the download page published by
# `../sign-ai-android/tools/wifi/publicar-apk.sh` and served by `caddy` at
# `/apk/` (docs/plan-wifi.md, phase 2). They are build artifacts: only the
# directory stays tracked, so the bind mount has a source on a fresh clone and
# Docker does not create it owned by root.
deploy/apk/*
!deploy/apk/.gitkeep
