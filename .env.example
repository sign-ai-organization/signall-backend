APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# Neon PostgreSQL connection string.
DATABASE_URL=

# External LLM provider.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_MS=10000

# Base URL of an OpenAI-compatible endpoint. Empty means OpenAI itself.
# Point it at a local model server to run the same prompt offline, with no API
# key and no cost: Ollama (http://localhost:11434/v1, e.g. qwen3:4b-instruct),
# LM Studio, vLLM, llama.cpp's server.
# The first call after starting Ollama loads the model into memory and can take
# a minute, which exceeds LLM_TIMEOUT_MS — warm it up once with
# `ollama run <model>` before testing.
LLM_BASE_URL=

# Max cosine distance (pgvector <=>) to count as a semantic cache HIT.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.15

# STT service (sign-ai-stt). Default matches docker-compose.yml's "stt"
# service name; override to ws://localhost:8000/ws/transcribe when running
# the backend outside Docker against a locally-run STT container.
STT_WS_URL=ws://stt:8000/ws/transcribe
