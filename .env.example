APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# Send per-step pipeline timings to the client ("trace" message). Debug only.
DEBUG_TRACE_ENABLED=false

# Neon PostgreSQL connection string.
DATABASE_URL=
# asyncpg connection pool, opened (and warmed up) at startup.
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=10
# 0 = never close idle pooled connections (the keep-alive manages idleness).
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME_SECONDS=0

# Keep Neon awake while there was recent activity, so its 5 min
# scale-to-zero does not hit the next phrase. Interval 0 disables it.
DB_KEEPALIVE_INTERVAL_SECONDS=240
DB_KEEPALIVE_IDLE_WINDOW_SECONDS=1200

# External LLM provider.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
# Ceiling of a single call to the model, and how many times a failed call is
# tried again. With 5 s and one retry the worst case is about 10 s: under the
# 15 s the Android client waits, so the error the user sees comes from the
# backend and not from the client's own clock.
LLM_TIMEOUT_MS=5000
LLM_MAX_RETRIES=1

# Any OpenAI-compatible endpoint. EMPTY = OpenAI itself, which is the default.
# Point it at a local model server to run the same prompt offline:
#
#   Ollama     http://127.0.0.1:11434/v1
#   LM Studio  http://127.0.0.1:1234/v1
#   vLLM       http://127.0.0.1:8000/v1
#
# `127.0.0.1` and not `host.docker.internal` because docker-compose.yml runs the
# backend with `network_mode: host`. Docker installs a DROP policy for
# bridge-to-host traffic, so a container on the default bridge cannot open a
# socket to a server bound on the host's loopback; on the host network that
# loopback is the backend's own. It is also why the STT is addressed by its
# published port (see STT_WS_URL below) and not by the "stt" service name,
# which only resolves on a user-defined bridge.
#
# Local servers ignore LLM_API_KEY; set it to any placeholder ("ollama") when
# the base URL is local, so a real OpenAI key is never sent off the machine.
LLM_BASE_URL=

# One filler call at start-up so the first phrase does not pay for loading the
# model into memory: measured 6.2 s on the first call against 270-440 ms on the
# ones after it. It runs apart from the start-up, so no session waits for it.
# Set to false to skip it.
LLM_WARMUP_ENABLED=true

# Max cosine distance (pgvector <=>) to count as a semantic cache HIT.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.05

# Load the whole semantic_cache into memory at start-up. A trip to Neon costs
# ~100 ms here and the full lookup ~200 ms, which is more than the LLM call the
# cache is there to avoid, so consulting it over the network loses either way.
# It is a derived cache: it rebuilds itself from the first occurrence of each
# phrase, so losing it costs no information.
SEMANTIC_CACHE_PRELOAD=true

# Row ceiling for that in-memory copy. It grows with what people say; this caps
# it instead of letting the process take the memory.
SEMANTIC_CACHE_MAX_ROWS=20000

# STT service (sign-ai-stt). Default matches docker-compose.yml's "stt"
# service name; override to ws://localhost:8000/ws/transcribe when running
# the backend outside Docker against a locally-run STT container.
STT_WS_URL=ws://stt:8000/ws/transcribe


# false = translate the whole text as a single sentence. The remaining
# parameters (word lists, thresholds) default to the evaluated values; see
# app/config/sentence_segmenter.py. Lists are given as JSON.
SENTENCE_SEGMENTER__ENABLED=true