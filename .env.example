APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# Send per-step pipeline timings to the client ("trace" message). Debug only.
DEBUG_TRACE_ENABLED=false

# Neon PostgreSQL connection string.
DATABASE_URL=
# asyncpg connection pool, opened (and warmed up) at startup.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# 0 = never close idle pooled connections (the keep-alive manages idleness).
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME_SECONDS=0

# Keep Neon awake while there was recent activity, so its 5 min
# scale-to-zero does not hit the next phrase. Interval 0 disables it.
DB_KEEPALIVE_INTERVAL_SECONDS=240
DB_KEEPALIVE_IDLE_WINDOW_SECONDS=1200

# External LLM provider.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_MS=10000

# Max cosine distance (pgvector <=>) to count as a semantic cache HIT.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.15

# STT service (sign-ai-stt). Default matches docker-compose.yml's "stt"
# service name; override to ws://localhost:8000/ws/transcribe when running
# the backend outside Docker against a locally-run STT container.
STT_WS_URL=ws://stt:8000/ws/transcribe


# false = translate the whole text as a single sentence. The remaining
# parameters (word lists, thresholds) default to the evaluated values; see
# app/config/sentence_segmenter.py. Lists are given as JSON.
SENTENCE_SEGMENTER__ENABLED=true