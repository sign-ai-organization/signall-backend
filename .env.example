APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# Send per-step pipeline timings to the client ("trace" message). Debug only.
DEBUG_TRACE_ENABLED=false

# RNF-SEC-02: largest audio fragment accepted from the client, in bytes. A
# normal 30 ms chunk at 16 kHz is 960 bytes; 32 KiB is about one second, so a
# bigger frame is not a capture chunk. Empty fragments and odd byte counts
# (PCM16 samples are two bytes each) are rejected too. A rejected fragment
# closes the session.
AUDIO_MAX_CHUNK_BYTES=32768

# Neon PostgreSQL connection string.
DATABASE_URL=
# asyncpg connection pool, opened (and warmed up) at startup.
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=10
# 0 = never close idle pooled connections (the keep-alive manages idleness).
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME_SECONDS=0

# Ceiling of a single query, in seconds. A query that goes over it is
# cancelled and raises, so a database that stops answering becomes an error
# the client can see instead of a phrase that never comes back.
DB_COMMAND_TIMEOUT_SECONDS=5
# Ceiling of opening one connection. A database that accepts TCP and then
# stalls cannot hold the start-up for the operating system's timeout.
DB_CONNECT_TIMEOUT_SECONDS=5
# Ceiling of waiting for a free connection from the pool. It is a guard against
# a leaked connection, not the normal path: the pool has 5 to 10 connections.
DB_ACQUIRE_TIMEOUT_SECONDS=5
# How many times a failed query is tried again, and how long to wait between
# two attempts. One retry covers a database that is resuming from
# scale-to-zero; with the ceiling above the worst case is about 10 s, under
# the 15 s the Android client waits before it gives up on its own.
DB_MAX_RETRIES=1
DB_RETRY_DELAY_SECONDS=0.5

# Keep Neon awake while there was recent activity, so its 5 min
# scale-to-zero does not hit the next phrase. Interval 0 disables it.
DB_KEEPALIVE_INTERVAL_SECONDS=240
DB_KEEPALIVE_IDLE_WINDOW_SECONDS=1200

# External LLM provider.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
# Ceiling of a single call to the model, and how many times a failed call is
# tried again. With 5 s and one retry the worst case is about 10 s: under the
# 15 s the Android client waits, so the error the user sees comes from the
# backend and not from the client's own clock.
LLM_TIMEOUT_MS=5000
LLM_MAX_RETRIES=1

# Any OpenAI-compatible endpoint. EMPTY = OpenAI itself, which is the default.
# Point it at a local model server to run the same prompt offline:
#
#   Ollama     http://host.docker.internal:11434/v1   (red de compose, por defecto)
#   Ollama     http://127.0.0.1:11434/v1              (con docker-compose.host.yml)
#   LM Studio  http://host.docker.internal:1234/v1
#   vLLM       http://host.docker.internal:8000/v1
#
# The backend runs on the compose network (`docker-compose.yml`), so a model server
# on the host is reached through `host.docker.internal`, declared as the bridge
# gateway with `extra_hosts`. That works out of the box on Docker Desktop. On Linux
# the bridge-to-host path is filtered by the host firewall: with `ufw` active
# (verified on the thesis machine, 2026-10-26) a bridge container times out for
# both `172.17.0.1:11434` and `host.docker.internal:11434`, even though it reaches
# the internet. In that case use the host override, which is why the second address
# above exists:
#
#   docker compose -f docker-compose.yml -f docker-compose.host.yml up --build
#
# Local servers ignore LLM_API_KEY; set it to any placeholder ("ollama") when
# the base URL is local, so a real OpenAI key is never sent off the machine.
LLM_BASE_URL=

# One filler call at start-up so the first phrase does not pay for loading the
# model into memory: measured 6.2 s on the first call against 270-440 ms on the
# ones after it. It runs apart from the start-up, so no session waits for it.
# Set to false to skip it.
LLM_WARMUP_ENABLED=true

# Modelo de embeddings del caché semántico. Cambiarlo obliga a vaciar
# `semantic_cache`: los vectores guardados son de otro espacio y la distancia
# entre ellos ya no significa nada. PR-CAC-01 compara alternativas.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Max cosine distance (pgvector <=>) to count as a semantic cache HIT.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.03

# Load the whole semantic_cache into memory at start-up. A trip to Neon costs
# ~100 ms here and the full lookup ~200 ms, which is more than the LLM call the
# cache is there to avoid, so consulting it over the network loses either way.
# It is a derived cache: it rebuilds itself from the first occurrence of each
# phrase, so losing it costs no information.
SEMANTIC_CACHE_PRELOAD=true

# Row ceiling for that in-memory copy. It grows with what people say; this caps
# it instead of letting the process take the memory.
SEMANTIC_CACHE_MAX_ROWS=20000

# STT service (sign-ai-stt). Default matches docker-compose.yml's "stt"
# service name, because the backend runs on the compose network: `localhost`
# inside that container is the container itself. Override to
# ws://localhost:8000/ws/transcribe when running the backend outside Docker
# against a locally-run STT container. With `docker-compose.host.yml` the
# override sets ws://127.0.0.1:8000/ws/transcribe, since the service name does
# not resolve on the host network.
STT_WS_URL=ws://stt:8000/ws/transcribe


# false = translate the whole text as a single sentence. The remaining
# parameters (word lists, thresholds) default to the evaluated values; see
# app/config/sentence_segmenter.py. Lists are given as JSON.
SENTENCE_SEGMENTER__ENABLED=true